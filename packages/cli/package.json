{
  "name": "vibe-replay",
  "version": "0.2.7",
  "description": "Turn AI coding sessions into animated, interactive web replays. One command, one HTML file, share anywhere.",
  "keywords": [
    "ai",
    "animation",
    "claude",
    "coding",
    "cursor",
    "demo",
    "replay",
    "session",
    "sharing",
    "vibe-coding"
  ],
  "homepage": "https://vibe-replay.com",
  "bugs": {
    "url": "https://github.com/tuo-lei/vibe-replay/issues"
  },
  "license": "MIT",
  "author": "Tuo Lei",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuo-lei/vibe-replay"
  },
  "bin": {
    "vibe-replay": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "eval:sessions": "tsx scripts/eval-session-query.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@inquirer/prompts": "^8.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "chalk": "^5.3.0",
    "commander": "^15.0.0",
    "gifenc": "^1.0.3",
    "hono": "^4.12.26",
    "open": "^11.0.0",
    "ora": "^9.4.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vibe-replay/provider-claude-code": "workspace:*",
    "@vibe-replay/provider-codex": "workspace:*",
    "@vibe-replay/provider-contract": "workspace:*",
    "@vibe-replay/provider-core": "workspace:*",
    "@vibe-replay/provider-cursor": "workspace:*",
    "@vibe-replay/provider-hermes": "workspace:*",
    "@vibe-replay/provider-opencode": "workspace:*",
    "@vibe-replay/provider-pi": "workspace:*",
    "@vibe-replay/providers-default": "workspace:*",
    "@vibe-replay/replay-core": "workspace:*",
    "@vibe-replay/types": "workspace:*",
    "@vitest/coverage-v8": "4.1.9",
    "tsup": "^8.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
